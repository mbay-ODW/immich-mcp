IMMICH_BASE_URL=http://host.docker.internal:2283
IMMICH_API_KEY=replace-with-your-immich-api-key
IMMICH_TOOL_MODE=gateway
MCP_PORT=5050
MCP_PUBLIC_URL=http://localhost:5050
MCP_LOG_LEVEL=Information
DOWNLOAD_MODE=url
MAX_PAGE_SIZE=100

# OIDC bearer-token gate (fork addition, not in upstream barryw/ImmichMCP).
# Leave all four unset to run without auth (e.g. local stdio/dev use).
# When set, every request to /mcp and /upload/* must carry a valid
# Authelia-issued Bearer token; /health and /.well-known stay public.
OAUTH_ISSUER=https://authelia.example.com
OIDC_INTROSPECTION_URL=https://authelia.example.com/api/oidc/introspection
OIDC_CLIENT_ID=immich-mcp
OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
